#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

class IMarksStorage {
public:
    virtual void add(int mark) = 0;
    virtual const vector<int>& get() const = 0;
    virtual ~IMarksStorage() = default;
};

class VectorMarksStorage : public IMarksStorage {
private:
    vector<int> data;

public:
    void add(int mark) override {
        data.push_back(mark);
    }

    const vector<int>& get() const override {
        return data;
    }
};

class MarksVector {
private:
    IMarksStorage* storage;

public:
    MarksVector(IMarksStorage* storage) : storage(storage) {}

    void addMark(int mark) {
        storage->add(mark);
    }

    double calculateMedian() const {
        const auto& marks = storage->get();
        if (marks.empty()) return 0.0;

        vector<int> sortedMarks = marks;
        sort(sortedMarks.begin(), sortedMarks.end());

        int n = sortedMarks.size();
        if (n % 2 == 1)
            return sortedMarks[n / 2];
        else
            return (sortedMarks[n / 2 - 1] + sortedMarks[n / 2]) / 2.0;
    }
};

class Student {
private:
    string name;
    MarksVector marks;

public:
    Student(string name, MarksVector marks)
        : name(name), marks(marks) {}

    void printInfo() const {
        cout << "Student: " << name << endl;
        cout << "Median mark: " << marks.calculateMedian() << endl;
    }
};

int main() {
    auto* storage = new VectorMarksStorage();
    MarksVector mv(storage);
    mv.addMark(90);
    mv.addMark(75);
    mv.addMark(82);
    mv.addMark(100);
    mv.addMark(60);
    Student st("Lev Babak-Rybalko", mv);
    st.printInfo();
    delete storage;
    return 0;
}


