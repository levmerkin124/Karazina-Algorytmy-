#include <iostream>
using namespace std;

struct Arr {
    int* data;
    int capacity;
    int length;

    Arr(int cap = 10) {
        capacity = cap;
        length = 0;
        data = new int[capacity];
    }

    void push_back(int value) {
        if (length == capacity) {
            capacity *= 2;
            int* newData = new int[capacity];
            for (int i = 0; i < length; i++)
                newData[i] = data[i];
            delete[] data;
            data = newData;
        }
        data[length++] = value;
    }

    int& operator[](int index) {
        return data[index];
    }

    int size() const {
        return length;
    }

    ~Arr() {
        delete[] data;
    }
};

class Solution {
public:
    int removeElement(Arr& nums, int val) {
        int k = 0;
        for (int i = 0; i < nums.size(); i++) {
            if (nums[i] != val) {
                nums[k] = nums[i];
                k++;
            }
        }
        return k;
    }
};

int main() {
    Arr nums;
    nums.push_back(0);
    nums.push_back(1);
    nums.push_back(2);
    nums.push_back(2);
    nums.push_back(3);
    nums.push_back(0);
    nums.push_back(4);
    nums.push_back(2);
    int val = 2;
    Solution sol;
    int k = sol.removeElement(nums, val);
    cout << "k = " << k << endl;
    cout << "число після операції: ";
    for (int i = 0; i < nums.size(); i++) {
        if (i < k)
            cout << nums[i] << " ";
        else
            cout << "_ ";
    }
    cout << endl;
    return 0;
}
