#include <iostream>
#include <algorithm>
using namespace std;

class MarksStorage {
private:
    int* data;
    int capacity;
    int length;

    void expand() {
        int newCapacity = capacity * 2;
        int* newData = new int[newCapacity];
        for (int i = 0; i < length; i++)
            newData[i] = data[i];
        delete[] data;
        data = newData;
        capacity = newCapacity;
    }

public:
    MarksStorage()
        : capacity(4), length(0)
    {
        data = new int[capacity];
    }

    ~MarksStorage() {
        delete[] data;
    }

    void add(int mark) {
        if (length == capacity)
            expand();
        data[length++] = mark;
    }

    const int* get() const {
        return data;
    }

    int size() const {
        return length;
    }
};

class MarksVector {
private:
    MarksStorage* storage;

public:
    MarksVector(MarksStorage* storage)
        : storage(storage) {}

    void addMark(int mark) {
        storage->add(mark);
    }

    double calculateMedian() const {
        int n = storage->size();
        if (n == 0) return 0.0;
        int* arr = new int[n];
        const int* src = storage->get();
        for (int i = 0; i < n; i++) arr[i] = src[i];
        sort(arr, arr + n);
        double med;
        if (n % 2 == 1)
            med = arr[n / 2];
        else
            med = (arr[n / 2 - 1] + arr[n / 2]) / 2.0;

        delete[] arr;
        return med;
    }
};

class Student {
private:
    string name;
    MarksVector marks;

public:
    Student(string name, MarksVector marks)
        : name(name), marks(marks) {}

    void printInfo() const {
        cout << "Student: " << name << endl;
        cout << "Median mark: " << marks.calculateMedian() << endl;
    }
};

int main() {
    auto* storage = new MarksStorage();
    MarksVector mv(storage);
    mv.addMark(90);
    mv.addMark(75);
    mv.addMark(82);
    mv.addMark(100);
    mv.addMark(60);
    Student st("Lev Babak-Rybalko", mv);
    st.printInfo();
    delete storage;
    return 0;
}

